{
  "name": "hello-world-service",
  "version": "1.0.0",
  "description": "Hello World microservice with health probes and Prometheus metrics",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "express": "4.21.2",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "prom-client": "15.1.3"
  },
  "overrides": {
    "path-to-regexp": "0.1.13"
  },
  "devDependencies": {
    "eslint": "9.17.0",
    "jest": "29.7.0",
    "supertest": "7.0.0"
  }
}
